---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postLang, postSlug, findTranslation } from '../../../i18n/posts';
import { UI, formatDate } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const zhPosts = posts
    .filter((p) => postLang(p) === 'zh')
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return zhPosts.map((post, index) => {
    const newer = zhPosts[index - 1];
    const older = zhPosts[index + 1];
    return {
      params: { slug: postSlug(post) },
      props: {
        post,
        prevPostPath: newer ? `/zh/posts/${postSlug(newer)}/` : undefined,
        nextPostPath: older ? `/zh/posts/${postSlug(older)}/` : undefined,
      },
    };
  });
}

const lang = 'zh' as const;
const t = UI[lang];
const { post, prevPostPath, nextPostPath } = Astro.props as {
  post: CollectionEntry<'blog'>;
  prevPostPath?: string;
  nextPostPath?: string;
};
const { Content } = await render(post);

const enCounterpart = await findTranslation(post, 'en');
const altLangPath = enCounterpart ? `/posts/${postSlug(post)}/` : '/';

// Cantonese reading speed ~ 350 chars/min
const readingTime = (() => {
  const chars = post.body?.replace(/\s+/g, '').length ?? 0;
  return Math.max(1, Math.round(chars / 350));
})();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  isPost={true}
  lang={lang}
  altLangPath={altLangPath}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  keywords={post.data.keywords}
  tags={post.data.tags}
  ogImage={post.data.ogImage ?? post.data.heroImage}
  prevPostPath={prevPostPath}
  nextPostPath={nextPostPath}
>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <span class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
        {' · '}{t.readingTime(readingTime)}
        {post.data.updatedDate && (
          <> {' · '}{t.updatedPrefix}{' '}<time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, lang)}</time></>
        )}
      </span>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <a class="tag" href={`/zh/tags/${tag}/`}>#{tag}</a>
          ))}
        </div>
      )}
    </header>
    <div class="post-body">
      <Content />
    </div>
    {(prevPostPath || nextPostPath) && (
      <nav class="post-nav" aria-label="文章導覽">
        {nextPostPath && (
          <a class="post-nav-link post-nav-prev" href={nextPostPath} rel="next">
            <span class="post-nav-label">← 較舊</span>
          </a>
        )}
        {prevPostPath && (
          <a class="post-nav-link post-nav-next" href={prevPostPath} rel="prev">
            <span class="post-nav-label">較新 →</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
