---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postsForLang, postUrl } from '../../../i18n/posts';
import { UI, formatDate } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await postsForLang('zh');
  const tags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.add(t)));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const lang = 'zh' as const;
const t = UI[lang];
const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} lang={lang} altLangPath={`/tags/${tag}/`}>
  <h1>#{tag}</h1>
  <p style="color: var(--fg-dim);">{t.postsTagged(tag, posts.length)}</p>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
        <span class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
        </span>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
