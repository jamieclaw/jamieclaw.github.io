---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postsForLang, postUrl } from '../../i18n/posts';
import { UI, formatDate } from '../../i18n/ui';

const lang = 'zh' as const;
const t = UI[lang];
const posts = await postsForLang(lang);
---

<BaseLayout lang={lang}>
  {posts.length === 0 ? (
    <p style="color: var(--fg-faint);">{t.noPosts}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-card" href={postUrl(post)}>
            <span class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
            </span>
            <h2><span>{post.data.title}</span></h2>
            {post.data.description && <p class="post-desc">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
