---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { UI, LANGUAGES, langFromPath, localeUrl, SITE_AUTHOR, SITE_KEYWORDS, DEFAULT_OG_IMAGE, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  isPost?: boolean;
  lang?: Lang;
  /** Optional absolute/relative path to the same page in the OTHER locale. */
  altLangPath?: string;
  /** ARTICLE-ONLY METADATA — pass from post layout. */
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  keywords?: string[];
  tags?: string[];
  /** Social share image. Absolute path under /public (e.g. /og/foo.png) or full URL. */
  ogImage?: string;
  /** Adjacent posts for prev/next <link> hints in <head>. */
  prevPostPath?: string;
  nextPostPath?: string;
  /** If true, tell search engines not to index (e.g. 404 page). */
  noindex?: boolean;
}

const pathname = Astro.url.pathname;
const lang: Lang = Astro.props.lang ?? langFromPath(pathname);
const t = UI[lang];
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';

const {
  title,
  description = t.siteTagline,
  isPost = false,
  altLangPath,
  pubDate,
  updatedDate,
  author = SITE_AUTHOR,
  keywords,
  tags = [],
  ogImage,
  prevPostPath,
  nextPostPath,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${t.siteTitle}` : t.siteTitle;
const canonicalURL = new URL(pathname, Astro.site);

// Default altLangPath: toggle /zh prefix on current path.
const computedAltPath = (() => {
  if (altLangPath) return altLangPath;
  if (lang === 'en') return pathname === '/' ? '/zh/' : `/zh${pathname}`;
  // lang === 'zh'
  if (pathname === '/zh' || pathname === '/zh/') return '/';
  return pathname.replace(/^\/zh/, '') || '/';
})();

// Year for footer
const year = new Date().getFullYear();

// Is this the home page? Used to render the big hero.
const isHome = pathname === '/' || pathname === '/zh/' || pathname === '/zh';

// ───────── SEO ─────────
// Resolve final OG/Twitter image URL. Precedence:
//   1. Explicit ogImage prop (post frontmatter or page prop)
//   2. Auto-generated per-post card for posts: /og/<lang>/<slug>.png
//   3. Site-wide default
const ogImageResolved = (() => {
  if (ogImage) return new URL(ogImage, Astro.site).toString();
  if (isPost) {
    // Derive slug from pathname like /posts/foo/ or /zh/posts/foo/
    const m = pathname.match(/\/posts\/([^\/]+)\/?$/);
    if (m) return new URL(`/og/${lang}/${m[1]}.png`, Astro.site).toString();
  }
  return new URL(DEFAULT_OG_IMAGE, Astro.site).toString();
})();

const resolvedKeywords: string[] =
  keywords && keywords.length > 0
    ? keywords
    : tags.length > 0
    ? tags
    : [...SITE_KEYWORDS];

const ogType = isPost ? 'article' : 'website';

// JSON-LD structured data
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t.siteTitle,
  alternateName: 'JamClaw',
  url: Astro.site?.toString() ?? 'https://jamieclaw.github.io/',
  description: t.siteTagline,
  inLanguage: LANGUAGES[lang].htmlLang,
  author: { '@type': 'Person', name: SITE_AUTHOR },
  publisher: { '@type': 'Person', name: SITE_AUTHOR },
};

const blogPostingLd =
  isPost && pubDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        inLanguage: LANGUAGES[lang].htmlLang,
        datePublished: pubDate.toISOString(),
        dateModified: (updatedDate ?? pubDate).toISOString(),
        author: { '@type': 'Person', name: author },
        publisher: {
          '@type': 'Person',
          name: SITE_AUTHOR,
          url: Astro.site?.toString() ?? 'https://jamieclaw.github.io/',
        },
        image: ogImageResolved,
        url: canonicalURL.toString(),
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL.toString(),
        },
        keywords: resolvedKeywords.join(', '),
      }
    : null;

// BreadcrumbList: Home → (Posts) → current
const breadcrumbLd = (() => {
  const items: any[] = [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.siteTitle,
      item: new URL(lang === 'zh' ? '/zh/' : '/', Astro.site).toString(),
    },
  ];
  if (isPost) {
    items.push({
      '@type': 'ListItem',
      position: 2,
      name: title ?? '',
      item: canonicalURL.toString(),
    });
  } else if (pathname !== '/' && pathname !== '/zh/' && pathname !== '/zh') {
    items.push({
      '@type': 'ListItem',
      position: 2,
      name: title ?? pageTitle,
      item: canonicalURL.toString(),
    });
  }
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  };
})();
---

<!doctype html>
<html lang={LANGUAGES[lang].htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? pathname : computedAltPath, Astro.site)} />
  <link rel="alternate" hreflang="zh-HK" href={new URL(lang === 'zh' ? pathname : computedAltPath, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={`${t.siteTitle} (EN)`} href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${t.siteTitle} (粵)`} href="/zh/rss.xml" />

  {/* ─── SEO: keywords + author ─── */}
  <meta name="author" content={author} />
  {resolvedKeywords.length > 0 && <meta name="keywords" content={resolvedKeywords.join(', ')} />}
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

  {/* ─── Open Graph ─── */}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_HK' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_HK'} />
  <meta property="og:site_name" content={t.siteTitle} />
  <meta property="og:image" content={ogImageResolved} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title ?? t.siteTitle} />

  {/* ─── Article metadata (only on post pages) ─── */}
  {isPost && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
  {isPost && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  {isPost && <meta property="article:author" content={author} />}
  {isPost && tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  {isPost && <meta property="article:section" content="Commentary" />}

  {/* ─── Twitter Card ─── */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageResolved} />
  <meta name="twitter:image:alt" content={title ?? t.siteTitle} />

  {/* ─── Prev/Next navigation hints ─── */}
  {prevPostPath && <link rel="prev" href={new URL(prevPostPath, Astro.site)} />}
  {nextPostPath && <link rel="next" href={new URL(nextPostPath, Astro.site)} />}

  {/* ─── JSON-LD structured data ─── */}
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {blogPostingLd && <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />}

  <meta name="theme-color" content="#07080b" id="meta-theme-color" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,800;9..144,900&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+HK:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <script is:inline>
    // Theme init — runs on initial load and is re-invoked on SPA swaps
    // (see astro:after-swap listener below).
    //
    // Root cause of the theme/view-transition conflict:
    //   Astro ClientRouter syncs <html> attributes from the incoming
    //   (server-rendered) document onto the live <html> element during
    //   view transitions. Server-rendered HTML has <html lang="en">
    //   with NO data-theme attribute, so a user-selected 'light' theme
    //   would get wiped on every SPA navigation — the page would flash
    //   back to the CSS default (dark) until next reload.
    //
    // Fix: expose window.__applyTheme() so we can reapply the stored
    // preference on astro:after-swap (fires BEFORE paint, so no flash).
    window.__applyTheme = function (explicit) {
      try {
        var saved = explicit || localStorage.getItem('theme');
        var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (sysDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var m = document.getElementById('meta-theme-color');
        if (m) m.setAttribute('content', theme === 'dark' ? '#07080b' : '#f7f5f2');
        return theme;
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
        return 'dark';
      }
    };
    window.__applyTheme();
  </script>

  <ClientRouter fallback="animate" />
</head>
<body class:list={[`lang-${lang}`, isHome && 'is-home']}>
  {isPost && <div id="reading-progress" aria-hidden="true"></div>}

  <header class:list={['site-header', isHome && 'site-header--hero']}>
    <div class="site-header-inner">
      <a href={lang === 'zh' ? '/zh/' : '/'} class="site-wordmark" aria-label={t.siteTitle}>
        <span class="site-wordmark-text">{t.siteTitle}</span>
        <span class="site-wordmark-sub">{t.siteSubtitle}</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href={lang === 'zh' ? '/zh/' : '/'}>{t.navPosts}</a>
        <a href={lang === 'zh' ? '/zh/about/' : '/about/'}>{t.navAbout}</a>
        <a href={lang === 'zh' ? '/zh/rss.xml' : '/rss.xml'} data-astro-reload>{t.navRss}</a>

        <a
          class="lang-switch"
          href={computedAltPath}
          aria-label={t.toggleLang}
          title={t.toggleLang}
          data-current-lang={lang}
        >
          <span class:list={['lang-opt', lang === 'en' && 'active']}>EN</span>
          <span class="lang-sep">·</span>
          <span class:list={['lang-opt', lang === 'zh' && 'active']}>粵</span>
        </a>

        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label={t.toggleTheme}
          title={t.toggleTheme}
        >
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </button>
      </nav>
    </div>
  </header>

  {isHome && (
    <section class="hero">
      <div class="hero-inner">
        <h1 class="hero-title">{t.siteTitle}</h1>
        <p class="hero-sub">{t.siteTagline}</p>
      </div>
    </section>
  )}

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    {t.footer(year)} · <a href="https://github.com/jamieclaw">GitHub</a>
  </footer>

  <script is:inline>
    /*
     * All scripts below must be idempotent across both initial page load
     * and Astro ClientRouter SPA navigations. Key rules:
     *   - Use astro:page-load event so scripts re-run on each page swap.
     *   - Guard global listeners (window/document/MediaQueryList) with
     *     a single-bind flag so they don't stack per navigation.
     *   - Per-element listeners are safe to re-add on fresh DOM.
     *   - Disconnect IntersectionObservers on astro:before-swap to avoid
     *     leaks.
     */

    // ── Global single-bind guard ──────────────────────────────────
    var __jcBound = (window.__jcBound = window.__jcBound || {});

    // ── Theme toggle (re-bind on each swap, but guard mq listener) ─
    function initThemeToggle() {
      var btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.jcBound) return;
      btn.dataset.jcBound = '1';
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', next); } catch (e) {}
        window.__applyTheme(next);
        btn.classList.remove('is-switching');
        void btn.offsetWidth;
        btn.classList.add('is-switching');
        setTimeout(function () { btn.classList.remove('is-switching'); }, 560);
      });
    }
    if (!__jcBound.mqTheme) {
      __jcBound.mqTheme = true;
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      mq.addEventListener && mq.addEventListener('change', function () {
        // Only follow system changes if user hasn't picked an explicit preference.
        try { if (localStorage.getItem('theme')) return; } catch (_) {}
        window.__applyTheme();
      });
    }

    // ── View-transition theme preservation ────────────────────────
    // Astro ClientRouter copies <html> attributes from the incoming
    // server-rendered document during swap, which wipes data-theme.
    // astro:after-swap fires after DOM swap, before paint — the right
    // place to reapply so there's no visible flash.
    if (!__jcBound.themeSwap) {
      __jcBound.themeSwap = true;
      document.addEventListener('astro:after-swap', function () {
        if (window.__applyTheme) window.__applyTheme();
      });
    }

    // ── Reading progress + home-scrolled class (single global listener) ─
    function updateScroll() {
      var bar = document.getElementById('reading-progress');
      var isHome = document.body.classList.contains('is-home');
      var h = document.documentElement;
      var scrolled = h.scrollTop;
      var max = h.scrollHeight - h.clientHeight;
      if (bar) {
        var pct = max > 0 ? (scrolled / max) * 100 : 0;
        bar.style.width = pct + '%';
        if (pct > 98) bar.classList.add('complete');
        else bar.classList.remove('complete');
      }
      if (isHome) {
        if (scrolled > 120) document.body.classList.add('scrolled');
        else document.body.classList.remove('scrolled');
      }
    }
    if (!__jcBound.scroll) {
      __jcBound.scroll = true;
      var scrollTicking = false;
      document.addEventListener('scroll', function () {
        if (!scrollTicking) {
          requestAnimationFrame(function () { updateScroll(); scrollTicking = false; });
          scrollTicking = true;
        }
      }, { passive: true });
    }

    // ── Hero title letter-split (idempotent: skip if already split) ─
    function initHeroSplit() {
      var title = document.querySelector('.hero-title');
      if (!title) return;
      if (title.querySelector('.letter')) return; // already split
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      var text = title.textContent || '';
      title.textContent = '';
      var frag = document.createDocumentFragment();
      var chars = Array.from(text);
      chars.forEach(function (ch, i) {
        var s = document.createElement('span');
        s.className = ch === ' ' ? 'letter space' : 'letter';
        s.textContent = ch === ' ' ? '\u00a0' : ch;
        s.style.animationDelay = (90 + i * 45) + 'ms';
        frag.appendChild(s);
      });
      title.appendChild(frag);
    }

    // ── Hero parallax (per-page element, fresh listeners OK) ──────
    function initHeroParallax() {
      var hero = document.querySelector('.hero');
      if (!hero || hero.dataset.jcBound) return;
      hero.dataset.jcBound = '1';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      var rect;
      hero.addEventListener('mousemove', function (e) {
        if (!rect) rect = hero.getBoundingClientRect();
        var x = (e.clientX - rect.left - rect.width / 2) / rect.width;
        var y = (e.clientY - rect.top - rect.height / 2) / rect.height;
        hero.style.setProperty('--hx', (x * 8).toFixed(2) + 'px');
        hero.style.setProperty('--hy', (y * 6).toFixed(2) + 'px');
      }, { passive: true });
      hero.addEventListener('mouseleave', function () {
        hero.style.setProperty('--hx', '0px');
        hero.style.setProperty('--hy', '0px');
        rect = null;
      });
    }

    // ── IntersectionObserver: disconnect previous before creating ──
    function initReveal() {
      if (__jcBound.io) {
        try { __jcBound.io.disconnect(); } catch (_) {}
        __jcBound.io = null;
      }
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) return;
      var candidates = document.querySelectorAll(
        '.post-body > h2, .post-body > h3, .post-body > p, .post-body > ul, .post-body > ol, .post-body > blockquote, main > h1:not(.hero-title), main > h2'
      );
      candidates.forEach(function (el, i) {
        el.classList.add('reveal');
        if (i < 3) el.classList.add('stagger-' + (i + 1));
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      candidates.forEach(function (el) { io.observe(el); });
      __jcBound.io = io;
    }

    // ── Post card tilt (per-element bind guard) ──────────────────
    function initCardTilt() {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      var cards = document.querySelectorAll('.post-card');
      cards.forEach(function (card) {
        if (card.dataset.jcBound) return;
        card.dataset.jcBound = '1';
        card.addEventListener('mousemove', function (e) {
          var r = card.getBoundingClientRect();
          var x = (e.clientX - r.left) / r.width - 0.5;
          var y = (e.clientY - r.top) / r.height - 0.5;
          card.style.transform =
            'translateY(-3px) rotateX(' + (-y * 3).toFixed(2) + 'deg)' +
            ' rotateY(' + (x * 3).toFixed(2) + 'deg)';
        });
        card.addEventListener('mouseleave', function () {
          card.style.transform = '';
        });
      });
    }

    // ── Mobile infinite scroll (auto-append next page) ───────────
    // Progressive enhancement over the server-rendered numbered
    // pagination. On small / touch viewports we watch a sentinel at
    // the bottom of the list; when it scrolls into view we fetch the
    // next paginated page, lift its <li> post cards out, and append
    // them to the live list. Desktop keeps the visible numbered nav.
    //
    // Idempotency: guarded per-nav via __jcBound.infinite; the
    // IntersectionObserver is disconnected on astro:before-swap.
    function initInfiniteScroll() {
      // Tear down any observer from the previous page first.
      if (__jcBound.infinite) {
        try { __jcBound.infinite.disconnect(); } catch (_) {}
        __jcBound.infinite = null;
      }

      if (!('IntersectionObserver' in window) || !('fetch' in window)) return;

      var list = document.getElementById('post-list');
      var pag = document.querySelector('[data-pagination]');
      var wrap = document.querySelector('.infinite-scroll');
      var sentinel = document.querySelector('[data-infinite-sentinel]');
      if (!list || !pag || !wrap || !sentinel) return;

      // Only auto-append on mobile-sized / coarse-pointer screens.
      // Desktop users get the crawlable numbered nav.
      var isMobile =
        window.matchMedia('(max-width: 720px)').matches ||
        window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (!isMobile) return;

      // Activate: hide the numbered nav, reveal the status region.
      pag.setAttribute('hidden', '');
      wrap.setAttribute('aria-hidden', 'false');
      var statusEl = wrap.querySelector('[data-infinite-status]');
      var loadingEl = wrap.querySelector('.infinite-loading');
      var endEl = wrap.querySelector('.infinite-end');

      // Mutable cursor: next URL to fetch, and running page counter.
      var state = {
        nextUrl: pag.getAttribute('data-next-url') || '',
        lastPage: parseInt(pag.getAttribute('data-last-page') || '1', 10),
        loading: false,
        done: false,
      };

      function showStatus(mode) {
        if (statusEl) statusEl.removeAttribute('hidden');
        if (loadingEl) loadingEl.hidden = mode !== 'loading';
        if (endEl) endEl.hidden = mode !== 'end';
      }
      function finish() {
        state.done = true;
        showStatus('end');
        try { __jcBound.infinite.disconnect(); } catch (_) {}
      }

      function loadNext() {
        if (state.loading || state.done) return;
        if (!state.nextUrl) { finish(); return; }
        state.loading = true;
        showStatus('loading');

        var url = state.nextUrl;
        fetch(url, { headers: { 'X-Requested-With': 'infinite-scroll' } })
          .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.text();
          })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var newItems = doc.querySelectorAll('#post-list > li');
            var frag = document.createDocumentFragment();
            newItems.forEach(function (li) {
              frag.appendChild(document.importNode(li, true));
            });
            list.appendChild(frag);

            // Advance cursor from the fetched page's pagination data.
            var nextPag = doc.querySelector('[data-pagination]');
            state.nextUrl = nextPag ? (nextPag.getAttribute('data-next-url') || '') : '';

            // Re-bind card tilt on the freshly appended cards.
            if (typeof initCardTilt === 'function') initCardTilt();

            state.loading = false;
            if (statusEl) statusEl.setAttribute('hidden', '');

            if (!state.nextUrl) {
              finish();
            } else {
              // If the sentinel is still in view (tall screen), keep going.
              var r = sentinel.getBoundingClientRect();
              if (r.top < window.innerHeight + 400) loadNext();
            }
          })
          .catch(function () {
            // Network / parse error: re-enable numbered nav as fallback.
            state.loading = false;
            if (statusEl) statusEl.setAttribute('hidden', '');
            pag.removeAttribute('hidden');
          });
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) loadNext();
        });
      }, { rootMargin: '0px 0px 600px 0px', threshold: 0 });
      io.observe(sentinel);
      __jcBound.infinite = io;
    }

    // ── Master init: run on initial load AND every SPA swap ──────
    function initAll() {
      initThemeToggle();
      initHeroSplit();
      initHeroParallax();
      initReveal();
      initCardTilt();
      initInfiniteScroll();
      updateScroll();
    }

    // Initial DOM-ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    // SPA navigations
    document.addEventListener('astro:page-load', initAll);
  </script>
</body>
</html>
